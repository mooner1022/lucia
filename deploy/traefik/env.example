# deploy/traefik/docker-compose.yml이 읽는 값. 이 파일을 .env로 복사해 고친다(.env는 레포에 올라가지 않는다).

# 밖에서 쓸 주소(데몬 설정 [public] admin_url·gateway_url의 호스트와 같다)
LUCIA_PUBLIC_HOST=lucia.example.com
# 데몬이 듣는 주소(데몬 설정 [admin] bind, [gateway] bind). Traefik 컨테이너에서 닿는 주소여야 한다.
LUCIA_ADMIN_UPSTREAM=http://192.168.0.10:8780
LUCIA_API_UPSTREAM=http://192.168.0.10:8790

# 아래는 기본값과 다를 때만 적는다.
# Traefik이 붙어 있는 Docker 망의 이름(기본 proxy)
# LUCIA_TRAEFIK_NETWORK=proxy
# TLS 입구의 이름(기본 websecure)
# LUCIA_TRAEFIK_ENTRYPOINT=websecure
# 라우터에 걸 미들웨어(쉼표로 여럿). 예: 앞의 CDN에서 실제 접속 주소를 꺼내는 미들웨어
# LUCIA_TRAEFIK_MIDDLEWARES=real-ip@file
